{
  "version": 2,
  "notes": "Shared scenarios for RocketSim (ground truth) vs carSim.js. Units: uu/cm, seconds, radians. Frame: Z-up. Identity orientation = forward +X, right +Y, up +Z (RocketSim RotMat). Air scenarios use THE_VOID; ground scenarios use SOCCAR + collision_meshes.",
  "defaults": {
    "tick_rate": 120,
    "settle_ticks": 240,
    "initial": {
      "pos": [0, 0, 800],
      "vel": [0, 0, 0],
      "ang_vel": [0, 0, 0],
      "yaw": 0,
      "pitch": 0,
      "roll": 0,
      "boost": 100,
      "on_ground": false
    },
    "controls": {
      "throttle": 0,
      "steer": 0,
      "pitch": 0,
      "yaw": 0,
      "roll": 0,
      "boost": false,
      "jump": false,
      "handbrake": false
    }
  },
  "scenarios": [
