{
  "version": 2,
  "notes": "Shared scenarios for RocketSim (ground truth) vs carSim.js. Units: uu/cm, seconds, radians. Frame: Z-up. Identity orientation = forward +X, right +Y, up +Z (RocketSim RotMat). Air scenarios use THE_VOID; ground scenarios use SOCCAR + collision_meshes.",
  "defaults": {
    "tick_rate": 120,
    "settle_ticks": 240,
    "initial": {
      "pos": [0, 0, 800],
      "vel": [0, 0, 0],
      "ang_vel": [0, 0, 0],
      "yaw": 0,
      "pitch": 0,
      "roll": 0,
      "boost": 100,
      "on_ground": false
    },
    "controls": {
      "throttle": 0,
      "steer": 0,
      "pitch": 0,
      "yaw": 0,
      "roll": 0,
      "boost": false,
      "jump": false,
      "handbrake": false
    }
  },
  "scenarios": [
    {
      "id": "freefall_1s",
      "description": "No input mid-air for 1s — gravity only",
      "ticks": 120
    },
    {
      "id": "air_throttle_1s",
      "description": "Full forward air throttle for 1s",
      "ticks": 120,
      "controls": { "throttle": 1 }
    },
    {
      "id": "air_boost_1s",
      "description": "Full boost mid-air for 1s",
      "ticks": 120,
      "controls": { "boost": true }
    },
    {
      "id": "roll_right_1s",
      "description": "Hold air-roll right for 1s from rest",
      "ticks": 120,
      "controls": { "roll": 1 }
    },
    {
      "id": "roll_left_1s",
      "description": "Hold air-roll left for 1s from rest",
      "ticks": 120,
      "controls": { "roll": -1 }
    },
    {
      "id": "pitch_up_0_5s",
      "description": "Hold pitch up for 0.5s from rest",
      "ticks": 60,
      "controls": { "pitch": 1 }
    },
    {
      "id": "pitch_down_0_5s",
      "description": "Hold pitch down for 0.5s from rest",
      "ticks": 60,
      "controls": { "pitch": -1 }
    },
    {
      "id": "yaw_right_0_5s",
      "description": "Hold yaw right for 0.5s from rest",
      "ticks": 60,
      "controls": { "yaw": 1 }
    },
    {
      "id": "yaw_left_0_5s",
      "description": "Hold yaw left for 0.5s from rest",
      "ticks": 60,
      "controls": { "yaw": -1 }
    },
    {
      "id": "roll_then_release",
      "description": "Roll right 0.5s then release 0.5s (coast angle)",
      "ticks": 120,
      "control_schedule": [
        { "until_tick": 60, "controls": { "roll": 1 } },
        { "until_tick": 120, "controls": { "roll": 0 } }
      ]
    },
    {
      "id": "combo_pitch_roll_1s",
      "description": "Pitch up + roll right together for 1s",
      "ticks": 120,
      "controls": { "pitch": 1, "roll": 1 }
    },
    {
      "id": "roll_from_pitch45",
      "description": "Start pitched +45°, hold air-roll right — must spin about nose",
      "ticks": 90,
      "initial": { "pitch": 0.7853981633974483 },
      "controls": { "roll": 1 }
    },
    {
      "id": "roll_from_pitch90",
      "description": "Start pitched +90° (nose up), hold air-roll right",
      "ticks": 90,
      "initial": { "pitch": 1.5707963267948966 },
      "controls": { "roll": 1 }
    },
    {
      "id": "yaw_from_roll90",
      "description": "Start rolled 90°, hold yaw right — body-up yaw",
      "ticks": 60,
      "initial": { "roll": 1.5707963267948966 },
      "controls": { "yaw": 1 }
    },
    {
      "id": "combo_from_yaw90",
      "description": "Start yawed 90°, pitch+roll together",
      "ticks": 90,
      "initial": { "yaw": 1.5707963267948966 },
      "controls": { "pitch": 1, "roll": 1 }
    },
    {
      "id": "partial_inputs_air",
      "description": "Half pitch + half yaw + half roll for 1s",
      "ticks": 120,
      "controls": { "pitch": 0.5, "yaw": 0.5, "roll": 0.5 }
    },
    {
      "id": "boost_and_pitch_1s",
      "description": "Boost while pitching up for 1s",
      "ticks": 120,
      "controls": { "boost": true, "pitch": 1 }
    },
    {
      "id": "double_jump_air",
      "description": "Second jump impulse while already airborne (tap jump 3 ticks)",
      "ticks": 60,
      "control_schedule": [
        { "until_tick": 3, "controls": { "jump": true } },
        { "until_tick": 60, "controls": { "jump": false } }
      ]
    },
    {
      "id": "flip_forward_air",
      "description": "Forward dodge from rest in air (pitch down + jump)",
      "ticks": 90,
      "control_schedule": [
        { "until_tick": 3, "controls": { "jump": true, "pitch": -1 } },
        { "until_tick": 90, "controls": { "jump": false, "pitch": 0 } }
      ]
    },
    {
      "id": "flip_side_air",
      "description": "Side dodge right from rest in air (yaw right + jump)",
      "ticks": 90,
      "control_schedule": [
        { "until_tick": 3, "controls": { "jump": true, "yaw": 1 } },
        { "until_tick": 90, "controls": { "jump": false, "yaw": 0 } }
      ]
    },
    {
      "id": "coast_from_spin",
      "description": "Release inputs with initial roll rate 5.5 rad/s — damping coast",
      "ticks": 120,
      "initial": { "ang_vel": [-5.5, 0, 0] }
    },

    {
      "id": "ground_rest_0_5s",
      "description": "Settled Octane on floor, no input for 0.5s",
      "game_mode": "soccar",
      "ticks": 60,
      "initial": {
        "pos": [0, 0, 17],
        "on_ground": true
      }
    },
    {
      "id": "ground_throttle_2s",
      "description": "Full throttle on open floor facing +Y for 2s",
      "game_mode": "soccar",
      "ticks": 240,
      "initial": {
        "pos": [0, -4000, 17],
        "yaw": 1.5707963267948966,
        "on_ground": true
      },
      "controls": { "throttle": 1 }
    },
    {
      "id": "ground_throttle_4s",
      "description": "Full throttle on open floor to drive-speed cap",
      "game_mode": "soccar",
      "ticks": 480,
      "initial": {
        "pos": [0, -4000, 17],
        "yaw": 1.5707963267948966,
        "on_ground": true
      },
      "controls": { "throttle": 1 }
    },
    {
      "id": "ground_boost_2s",
      "description": "Throttle + boost on open floor for 2s",
      "game_mode": "soccar",
      "ticks": 240,
      "initial": {
        "pos": [0, -4000, 17],
        "yaw": 1.5707963267948966,
        "on_ground": true,
        "boost": 100
      },
      "controls": { "throttle": 1, "boost": true }
    },
    {
      "id": "ground_steer_right_1s",
      "description": "Throttle 1s then throttle+steer right 1s",
      "game_mode": "soccar",
      "ticks": 240,
      "initial": {
        "pos": [0, 0, 17],
        "yaw": 0,
        "on_ground": true
      },
      "control_schedule": [
        { "until_tick": 120, "controls": { "throttle": 1, "steer": 0 } },
        { "until_tick": 240, "controls": { "throttle": 1, "steer": 1 } }
      ]
    },
    {
      "id": "ground_steer_left_1s",
      "description": "Throttle 1s then throttle+steer left 1s",
      "game_mode": "soccar",
      "ticks": 240,
      "initial": {
        "pos": [0, 0, 17],
        "yaw": 0,
        "on_ground": true
      },
      "control_schedule": [
        { "until_tick": 120, "controls": { "throttle": 1, "steer": 0 } },
        { "until_tick": 240, "controls": { "throttle": 1, "steer": -1 } }
      ]
    },
    {
      "id": "ground_coast_1s",
      "description": "Throttle to speed then coast 1s",
      "game_mode": "soccar",
      "ticks": 720,
      "initial": {
        "pos": [0, -4000, 17],
        "yaw": 1.5707963267948966,
        "on_ground": true
      },
      "control_schedule": [
        { "until_tick": 600, "controls": { "throttle": 1 } },
        { "until_tick": 720, "controls": { "throttle": 0 } }
      ]
    },
    {
      "id": "ground_brake_0_25s",
      "description": "Throttle to speed then reverse-brake 0.25s",
      "game_mode": "soccar",
      "ticks": 630,
      "initial": {
        "pos": [0, -4000, 17],
        "yaw": 1.5707963267948966,
        "on_ground": true
      },
      "control_schedule": [
        { "until_tick": 600, "controls": { "throttle": 1 } },
        { "until_tick": 630, "controls": { "throttle": -1 } }
      ]
    },
    {
      "id": "ground_powerslide_0_5s",
      "description": "Throttle 2s then throttle+steer+handbrake 0.5s",
      "game_mode": "soccar",
      "ticks": 300,
      "initial": {
        "pos": [0, 0, 17],
        "yaw": 0,
        "on_ground": true
      },
      "control_schedule": [
        { "until_tick": 240, "controls": { "throttle": 1, "steer": 0, "handbrake": false } },
        { "until_tick": 300, "controls": { "throttle": 1, "steer": 1, "handbrake": true } }
      ]
    },
    {
      "id": "ground_jump_full_hold",
      "description": "Full hold jump from settled ground",
      "game_mode": "soccar",
      "ticks": 120,
      "initial": {
        "pos": [0, 0, 17],
        "on_ground": true
      },
      "controls": { "jump": true }
    },
    {
      "id": "ground_jump_tap",
      "description": "Single-tick jump tap from settled ground",
      "game_mode": "soccar",
      "ticks": 120,
      "initial": {
        "pos": [0, 0, 17],
        "on_ground": true
      },
      "control_schedule": [
        { "until_tick": 1, "controls": { "jump": true } },
        { "until_tick": 120, "controls": { "jump": false } }
      ]
    },
    {
      "id": "ground_flip_forward",
      "description": "Jump then forward flip from ground",
      "game_mode": "soccar",
      "ticks": 120,
      "initial": {
        "pos": [0, 0, 17],
        "on_ground": true
      },
      "control_schedule": [
        { "until_tick": 3, "controls": { "jump": true } },
        { "until_tick": 15, "controls": { "jump": false } },
        { "until_tick": 120, "controls": { "jump": true, "pitch": -1 } }
      ]
    },
    {
      "id": "wall_drive_throttle_3s",
      "description": "Drive into +X wall and climb with throttle only",
      "game_mode": "soccar",
      "ticks": 360,
      "initial": {
        "pos": [3000, 0, 17],
        "yaw": 0,
        "on_ground": true
      },
      "controls": { "throttle": 1 }
    },
    {
      "id": "ground_jump_into_wall",
      "description": "Jump + boost into +X wall curve and climb (wheels on wall)",
      "game_mode": "soccar",
      "ticks": 180,
      "initial": {
        "pos": [3600, 0, 17],
        "yaw": 0,
        "on_ground": true
      },
      "control_schedule": [
        { "until_tick": 3, "controls": { "jump": true, "throttle": 1 } },
        { "until_tick": 180, "controls": { "throttle": 1, "boost": true } }
      ]
    }
  ]
}
